IDFM_API_KEY=replace-with-your-idfm-prim-token
# Nearby requests: unlimited in dev, at most 4 in production by default.
# Explicit true/false overrides both defaults; rebuild/restart after changing.
# UNLIMITED_NETWORK=false
# Optional pedestrian road-routing fallback. PRIM/Navitia is preferred for
# individual walking routes; ORS is also used for the annuary's bulk matrix
# and the nearby map's walking isochrones.
# Keep this server-side; never use a NUXT_PUBLIC_ variable for the key.
# NUXT_ORS_API_KEY=replace-with-your-openrouteservice-key
# NUXT_ORS_API_URL=https://api.openrouteservice.org
# The global radar is generated separately in idfm-node-backend, which has its
# own ORS configuration. Nuxt only serves precomputed selections from the atlas.
# See docs/global-map-isochrones.md for Docker, local storage and R2 settings.
# Optional restricted-dataset token. IDFM_API_KEY is preferred for the global
# bulk endpoint; this is used as a fallback and sent as `Authorization: apikey`.
# IDFM_DATASET_KEY=replace-with-your-idfm-dataset-token
# Comma-separated npm packages included at build time. Empty means no plugin.
# ENABLED_PLUGINS=@transport-clock/realtime-vehicles
# Hard build guard. When true, ENABLED_PLUGINS must be empty.
# DISALLOW_PLUGINS=true
# Required only for `npm run build:capacitor`. This is the public URL of the
# deployed Nuxt backend that serves the /api routes (without a trailing slash).
# NUXT_PUBLIC_API_BASE_URL=https://transport-clock.example.com
# IDFM_NETEX_CACHE_LOCAL=../idfm-node-backend/public/data/netex
IDFM_NETEX_CACHE_REMOTE=r2://idfm-backend-netex-cache/netex/current
# Optional: by default ridership derives the same bucket and uses /ridership.
# IDFM_RIDERSHIP_CACHE_REMOTE=r2://idfm-backend-netex-cache/ridership
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# GTFS line geometry is enabled by default. Nuxt only reads the published data.
GTFS_ENABLED=true
# Used only by npm run gtfs:update / gtfs:reset when publishing to R2.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# GTFS_R2_BUCKET=idfm-gtfs


# Optional Home Assistant API protection and stable deployment identity.
# TRANSPORT_CLOCK_HA_TOKEN=replace-with-a-long-random-token
# TRANSPORT_CLOCK_INSTANCE_ID=transport-clock-production
# JSON compilé par idfm-node-backend, lu directement par le serveur Nitro.
# Par défaut : ../idfm-node-backend/.data/neighborhood-verdict/compiled.json
# NUXT_NEIGHBORHOOD_VERDICT_DATA_PATH=../idfm-node-backend/.data/neighborhood-verdict/compiled.json
# Pour une nouvelle édition air-bruit conservant les mêmes noms de fichiers :
# NEIGHBORHOOD_VERDICT_AIR_NOISE_REFERENCE_PERIOD=2025
# NEIGHBORHOOD_VERDICT_AIR_NOISE_FRESHNESS_DATE=2025-08-22

# Server-side walking radar archive generated by idfm-node-backend.
# Local Node default: ../idfm-node-backend/public/data/isochrones/walking-isochrones.zip
IDFM_MAP_ISOCHRONES_LOCAL=
# Remote takes priority; use an HTTP URL with HEAD/Range + strong ETag, or private r2://bucket/key.
# R2 reuses R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY (server only).
IDFM_MAP_ISOCHRONES_REMOTE=

# Private R2 object for the compiled neighborhood verdict (remote takes priority).
# IDFM_NEIGHBORHOOD_VERDICT_CACHE_REMOTE=r2://idfm-backend-netex-cache/neighborhood-verdict/compiled.json
