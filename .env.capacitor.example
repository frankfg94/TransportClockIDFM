CAPACITOR_BUILD=true
# URL publique du déploiement Nuxt qui conserve les routes serveur /api.
# Exemple : https://transport-clock.pages.dev
NUXT_PUBLIC_API_BASE_URL=
# Never put IDFM_API_KEY in this file. It belongs in the server-side
# environment variables of the Cloudflare Pages deployment.

# Walking radar calls the deployed Nuxt API through NUXT_PUBLIC_API_BASE_URL.
# The global atlas and ORS credentials are never included in the APK.
